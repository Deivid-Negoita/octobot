# Normalize to LF in the repository, check out native on Windows.
* text=auto

# KiCad files are text but must never have their line endings rewritten by a
# tool that does not understand the format.
*.kicad_pcb  text eol=lf
*.kicad_sch  text eol=lf
*.kicad_pro  text eol=lf
*.kicad_sym  text eol=lf
*.gbr        text eol=lf
*.drl        text eol=lf

*.sh         text eol=lf
*.bat        text eol=crlf

# Binary — never diff, never convert.
*.glb        binary
*.step       binary
*.zip        binary
*.png        binary
*.pdf        binary

# Collapse generated and vendored files in pull request diffs.
hardware/fabrication/**  linguist-generated
mechanical/**            linguist-vendored
docs/images/**           linguist-documentation
